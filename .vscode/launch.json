{
    "version": "0.2.0",
    "configurations": [
        {
            // デフォルト: 現在開いているアクティブなファイルを単体デバッグ実行
            "name": "▶ Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${fileDirname}",
            "justMyCode": true
        },
        {
            // 統合ランナー (main.py) を実行
            "name": "▶ Python: Run main.py (All Modules)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            // 標準ライブラリや外部パッケージの内部までステップイン
            "name": "▶ Python: Current File (Deep Step-In)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${fileDirname}",
            "justMyCode": false
        }
    ]
}
